# Required
ANTHROPIC_API_KEY=...

# Gateway base URL (AgentRouter). Leave empty/unset to hit api.anthropic.com directly.
ANTHROPIC_BASE_URL=https://agentrouter.org

# Optional: LinkedIn credentials (for scraping)
# WARNING: LinkedIn ToS prohibits scraping. Use at own risk.
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=yourpassword

# Optional: RapidAPI key for JSearch (Indeed/Glassdoor jobs)
RAPIDAPI_KEY=your_rapidapi_key

# Optional: Proxies for scraping (comma-separated)
# SCRAPING_PROXIES=http://proxy1:port,http://proxy2:port

# Search settings (optional, have defaults)
MAX_JOBS_PER_SOURCE=25
RELEVANCE_THRESHOLD=0.6
CLAUDE_MODEL=claude-opus-5

NVIDIA_API_KEY=....
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-pro-0813

